public static class Program {
    public static func main() {
        fn validate_config() {
            out "ENTERED validate_config"
            out "Checking..."
            if ( $config[mode] == "production" ) {
                out "Production mode verified."
                return "SUCCESS"
            } else {
                out "Development mode detected."
                return "DEV_MODE"
            }
        }
        let config = Map("mode", "production", )
        validate_config
        
        return 0
    }
}
