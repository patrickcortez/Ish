iecho "--- Starting Test 02: Math & Logic ---"

let a = expr 10 + 5 * 2
let b = expr ( 10 + 5 ) * 2

iecho "10 + 5 * 2 evaluates to: $a"
iecho "( 10 + 5 ) * 2 evaluates to: $b"

if ( $a == 20 ) {
    iecho "Standard precedence is working correctly!"
} else {
    iecho "Math parser failed precedence test."
}

iecho "Testing logical operators..."
let success_flag = 1
let fail_flag = 0

if ( $success_flag == 1 && $fail_flag == 0 ) {
    iecho "Logical AND (&&) works!"
}

if ( $success_flag == 0 || $fail_flag == 0 ) {
    iecho "Logical OR (||) works!"
}

iecho "--- Test 02 Completed ---"
