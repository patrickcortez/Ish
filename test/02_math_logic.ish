public static class Program {
    public static func Main(params let[] args) {
        out "--- Starting Test 02: Math & Logic ---"
        
        declare a = "$(( 10 + 5 * 2 ))"
        declare b = "$(( ( 10 + 5 ) * 2 ))"
        
        out "10 + 5 * 2 evaluates to: $a"
        out "( 10 + 5 ) * 2 evaluates to: $b"
        
        if ( $a == 20 ) {
            out "Standard precedence is working correctly!"
        } else {
            out "Math parser failed precedence test."
        }
        
        out "Testing logical operators..."
        declare success_flag = 1
        declare fail_flag = 0
        
        if ( $success_flag == 1 && $fail_flag == 0 ) {
            out "Logical AND (&&) works!"
        }
        
        if ( $success_flag == 0 || $fail_flag == 0 ) {
            out "Logical OR (||) works!"
        }
        
        out "--- Test 02 Completed ---"
        
        return 0
    }
}
