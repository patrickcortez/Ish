iecho "--- Starting Test 05: Complex Pipelines & Async ---"

iecho "Creating temporary script file..."
iecho "iecho Working_Hard" to temp_task.ish

iecho "Running task in background..."
ish temp_task.ish job

iecho "Pipeline data routing test:"
let pipe_result = iecho "Pipeline Initial Data" : iecho "Pipeline Processed Data"
iecho "Piped command output was captured: $pipe_result"

iecho "Cleaning up temporary file..."
irm temp_task.ish

let target_iterations = expr 20 / 4

iecho "Running parallel loop..."
for ( i = 0, $i < $target_iterations ) {
    iecho "Main Thread Iteration: $i" while iecho "Parallel Thread Iteration: $i"
}

iecho "--- Test 05 Completed ---"
